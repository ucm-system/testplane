# TestPlane Web —— 环境变量（复制成 .env.local 生效，别提交 .env.local）

# 1 = 用 web/src/api/mock.ts 的假数据把页面填满（后端未起时的默认值）
# 0 = 打真实接口（走 vite 代理 /api → 127.0.0.1:8080）
VITE_USE_MOCK=1

# 接口前缀。design/views/07-api.md 定的是 /api/v1；服务端若改挂载点在这里改。
VITE_API_BASE=/api/v1

# 伪登录：默认用户（X-User 头）；运行期可在右上角改，改动存 localStorage
VITE_DEV_USER=dev

# 1 = 允许提交 tester.yaml 到 POST /v1/testers（后端 P0 只做只读注册表时留 0）
VITE_ENABLE_TESTER_REGISTER=0
