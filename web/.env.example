# TestPlane Web —— 环境变量（复制成 .env.local 生效；.env.local 已被 .gitignore 忽略）

# 默认 0 = 打真实后端。别把它改成 1 再提交：
# `make web` 产出的 dist 会被 go:embed 进二进制，默认开 mock 等于把假数据发给真实用户。
# 本地没后端、只想看页面时，在 .env.local 里显式开 1。
VITE_USE_MOCK=0

# 接口前缀。design/views/07-api.md 定的是 /api/v1；服务端若改挂载点在这里改。
VITE_API_BASE=/api/v1

# dev 鉴权：Authorization: Bearer <subject> 的默认值；运行期可在右上角改（存 localStorage）
VITE_DEV_USER=dev
