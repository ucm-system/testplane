# TestPlane Tester: aisbench-sla —— **真实 ais_bench 模式**镜像（本地/kind 验证用）
#
# 与 build/Dockerfile（stub 模式，python:3.11-slim + 自带 stub_aisbench）的区别：
#   基础镜像换成官方 AISBench benchmark 镜像，镜像里真的带 ais_bench 命令与它自己的
#   transformers/datasets/requests，所以 --aisbench_cmd 的默认值 `ais_bench` 是真命令，
#   stub 仍保留在 /tester/tool/tests/stub_aisbench.py 供离线回归用。
#
# 构建上下文 = **仓库根**：
#   cd <repo-root>
#   TAG=0.2.0
#   docker build -f testers/aisbench-sla/build/Dockerfile.aisbench \
#     -t ghcr.io/ucm-system/testplane-tester-aisbench-sla:${TAG} .
#
# ---------------------------------------------------------------------------
# 关键设计：为什么 ais_bench 的工作目录是 /tmp/aisbench-ws 而不是 /benchmark
# ---------------------------------------------------------------------------
# 官方镜像里 /benchmark 是 ais_bench 的源码根（pip 装的就是它，root:root 0755）。
# 本 Tester 的 vendored 工具会往 **work_path 下**写两样东西：
#   <work_path>/ais_bench/benchmark/configs/models/vllm_api/vllm_api_chat_temp.py  （模型配置）
#   <work_path>/ais_bench/datasets/gsm8k/{train,test}.jsonl                        （数据集挂载）
# 参考工具是靠「<work_path> 恰好就是源码根」让 ais_bench 找到它们的。平台的 Executor
# 用 ReadOnlyRootFilesystem=true 跑 Job（只有 /workspace/output 与 /tmp 可写），所以
# 平台上不可能写 /benchmark；把 /benchmark chown 给 10001 也只解决本地、解决不了平台。
#
# 于是这里改成「/tmp 下的影子源码根」，用 ais_bench 自己的两个开关接上：
#   * 数据集：ais_bench 的相对数据集路径是拼在 AIS_BENCH_DATASETS_CACHE 下的
#     （datasets/utils/datasets.py: get_cache_dir() 读该环境变量，默认才是源码根），
#     所以 run.sh 导出 AIS_BENCH_DATASETS_CACHE=<work_path> 即可让
#     path='ais_bench/datasets/gsm8k' 落到 <work_path>/ais_bench/datasets/gsm8k。
#   * 模型配置：ais_bench 支持 --config-dir，会在 <config-dir>/models 下找模型配置，
#     run.sh 在 work_path 不是 /benchmark 时自动追加
#     --config-dir <work_path>/ais_bench/benchmark/configs。
# 这两处都在 run.sh（本仓库自己的入口）里做，**没有改 vendored 的 sla_tool/**。
#
# ---------------------------------------------------------------------------
# tokenizer 注入：选「COPY 进镜像」（三选一里的第 1 种），理由见 README「验证镜像」
# ---------------------------------------------------------------------------
# Job 只挂产物 PVC，没有别的共享存储可挂；要在 kind 里跑通、又不想往节点里塞 hostPath，
# 最省事且可复现的就是把 15MB 的 Qwen3-0.6B tokenizer 打进镜像。
# **这只是验证镜像**：生产镜像不带 tokenizer，tokenizer 由 Execution Profile 挂载，
# 调用方用 --model_path 指容器内绝对路径。为了让「带了」和「没带」一眼可辨，这里只用
# 一个构建期可选 COPY，源码目录 testers/aisbench-sla/build/models/ 在 .gitignore 里，
# 不入库（见 build/.gitignore 与 README 的准备命令）。
#
# FROM 钉的是 README 里写的那一版（0330 master，py310），避免与 0630 那版行为漂移。
FROM ghcr.io/aisbench/aisbench_benchmark:v3.1-20260330-master_x86_64_py_310

ARG TESTER_UID=10001
ARG TESTER_GID=10001

# 非 root 运行时没有 /home，HF datasets 缓存会去 ~/.cache 炸掉：全部收进 /tmp（可写）。
ENV HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    HF_HOME=/tmp/hf \
    HF_DATASETS_CACHE=/tmp/hf/datasets \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 非 root 用户（§13.2 平台按 10001:10001 + fsGroup 挂产物卷）。
# /tmp 属于 10001：work_path 的默认位置就在这下面。
RUN groupadd -g ${TESTER_GID} tester \
 && useradd -u ${TESTER_UID} -g ${TESTER_GID} -M -d /tmp -s /bin/bash tester \
 && mkdir -p /tester /models /workspace/output /tmp/aisbench-ws \
 && chown -R ${TESTER_UID}:${TESTER_GID} /tester /models /workspace /tmp

# ---- 执行入口 ----------------------------------------------------------------
COPY testers/aisbench-sla/run.sh /tester/run.sh

# ---- vendored 工具（只读副本，不改上游代码）----------------------------------
COPY testers/aisbench-sla/tool /tester/tool

# ---- 离线冒烟用的小数据集（8 行 × 512 字符）-----------------------------------
COPY testers/aisbench-sla/tests/fixtures /tester/fixtures

# ---- 验证用 tokenizer（**仅此验证镜像带**；生产镜像靠 Profile 挂载）-------------
# 目录由 build/prepare-tokenizer.ps1（或手工 cp）从 D:\Models\Qwen3-0.6B 准备，
# 不在版本库里；缺了构建会直接失败，而不是悄悄做出一个跑不了的镜像。
COPY testers/aisbench-sla/build/models/Qwen3-0.6B /models/Qwen3-0.6B

RUN chmod 0755 /tester/run.sh /tester/tool/sla_search.py /tester/tool/tests/*.py \
 && chown -R ${TESTER_UID}:${TESTER_GID} /tester /models

# CRLF 归一到 LF：本仓库在 Windows 上检出时 `tool/tests/*.py` 可能带 CRLF，
# 带 CRLF 的 shebang 在 Linux 里会报 `/usr/bin/env: 'python3\r'`，直接把
# stub 模式（--aisbench_cmd=/tester/tool/tests/stub_aisbench.py）打死。
# 在镜像里擦一遍，比要求每个开发者配 .gitattributes 稳。
RUN sed -i 's/\r$//' /tester/run.sh \
 && find /tester/tool -name '*.py' -type f -exec sed -i 's/\r$//' {} +

USER ${TESTER_UID}:${TESTER_GID}

# /benchmark 是镜像自带的源码根（只读也无所谓：本镜像不往里写）。
WORKDIR /workspace

# 平台 Job Spec 的 command 也是 /tester/run.sh，二者等价。
ENTRYPOINT ["/tester/run.sh"]
