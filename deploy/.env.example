# ============================================================================
# TestPlane · 本地开发环境变量（deploy/.env.example）
# ----------------------------------------------------------------------------
# 用法：复制成 deploy/.env 后按需修改（deploy/.env 被根 .gitignore 的
#       `.env` / `.env.*` 规则忽略，不会入库；本文件永远只放占位值与本地默认值）。
#
#   Copy-Item deploy\.env.example deploy\.env
#
# ⚠️ 键名以 server/internal/config/config.go 与 server/internal/k8s/client.go
#    实际读取的为准（已核对 2026-11-05）。设计文档 §10 的表是长期口径，
#    代码是当下事实——两边不一致时改这份文件。
#
# 这些值只是 **dev** 默认值。staging/prod 的差异见
# design/views/06-physical-view.md §6.1 与 design/impl/web-and-delivery.md §10。
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL 16（docker 容器 testplane-pg，库/用户/口令都是 testplane）
# ---------------------------------------------------------------------------
# 端口：5432 空闲就用 5432；被占用时改用 5433 并同步改这里的值。
# 已核验（2026-11-05）：宿主 5432 无监听 → **实际用 5432**。
TESTPLANE_DB_HOST=127.0.0.1
TESTPLANE_DB_PORT=5432
TESTPLANE_DB_NAME=testplane
TESTPLANE_DB_USER=testplane
TESTPLANE_DB_PASSWORD=testplane

# 宿主上直接跑（go run ./cmd/testplaned）：
#   sslmode=disable —— dev 容器 PG 没配 TLS（prod 必须 require，06 §1）
TESTPLANE_DATABASE_URL=postgres://testplane:testplane@127.0.0.1:5432/testplane?sslmode=disable

# 在 kind 集群内跑（in-cluster Deployment）：PG 在宿主，走 host.docker.internal。
# 已核验：kind 节点内 `getent hosts host.docker.internal` → 192.168.65.254，且 5432 可连。
TESTPLANE_DATABASE_URL_INCLUSTER=postgres://testplane:testplane@host.docker.internal:5432/testplane?sslmode=disable

# 连接池：P0 单进程 20（06 §5.2）
TESTPLANE_DB_MAX_OPEN_CONNS=20

# ---------------------------------------------------------------------------
# 平台进程
# ---------------------------------------------------------------------------
TESTPLANE_HTTP_ADDR=:8080
# all | api | controller | collector（P0 用 all）
TESTPLANE_ROLE=all
TESTPLANE_LOG_LEVEL=info
# 仅 dev 允许；staging/prod 出现 dev 必须启动失败（06 §6.1 红线）
TESTPLANE_AUTH_MODE=dev

# 产物根目录：宿主上跑指向仓库内 .data\storage；Pod 内是 PVC 挂载点 /storage-root。
TESTPLANE_STORAGE_ROOT=D:\Project\TestPalne\.data\storage
TESTPLANE_STORAGE_ROOT_INCLUSTER=/storage-root

# Tester 注册表：镜像内 /app/testers（E-10）；本地开发指到仓库 testers/
TESTPLANE_TESTERS_DIR=./testers

# ---------------------------------------------------------------------------
# Kubernetes
# ---------------------------------------------------------------------------
# Job / Pod 所在 namespace（必须与 deploy/k8s/namespace.yaml 一致）。
# 代码读 TESTPLANE_NAMESPACE，TESTPLANE_EXECUTOR_NAMESPACE 是旧名（仍兼容）。
TESTPLANE_NAMESPACE=testplane

# 宿主上跑（不在集群内）时，client-go 按这个顺序找凭据：
#   TESTPLANE_KUBECONFIG → KUBECONFIG → ~/.kube/config
# kind 建集群时已把 context `kind-testplane` 写进 ~/.kube/config，所以通常留空即可。
# 想钉死某个 context：kubectl config use-context kind-testplane
TESTPLANE_KUBECONFIG=
# Pod 内跑时设 true：用 ServiceAccount，不找 kubeconfig（ConfigMap 里已是 true）
TESTPLANE_K8S_IN_CLUSTER=false

# Vendor hook（dev 不需要真实 Genet；留空即 mock 模式）
TESTPLANE_GENET_BASE_URL=

# ---------------------------------------------------------------------------
# 容量与保留（dev 都按 P0 默认值；*_RESERVED 是设计有、代码暂未读取的键）
# ---------------------------------------------------------------------------
TESTPLANE_MAX_GLOBAL_CONCURRENCY=20
TESTPLANE_RUN_MAX_TASKS=200
TESTPLANE_TASK_TIMEOUT=4h
TESTPLANE_TASK_TIMEOUT_MAX=24h
TESTPLANE_DEPLOY_TIMEOUT=72h
TESTPLANE_RESULT_MAX_BYTES=100MiB
TESTPLANE_SSE_HEARTBEAT=15s
TESTPLANE_SSE_REPLAY_HOURS=24
