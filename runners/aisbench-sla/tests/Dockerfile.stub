# Argus Runner: aisbench-sla —— **离线冒烟用的 stub 镜像**（不进发布）
#
# 发布矩阵只扫 `runners/<name>/build/Dockerfile*`，本文件在 `tests/` 下，**不会**被发布。
# 它用一个极小的 python 镜像 + 仓库自带的 `tool/tests/stub_aisbench.py` 顶替真 `ais_bench`，
# 让 `tests/smoke.sh` 在没有 6.4GB AISBench 基础镜像、没有模型/数据集的机器上也能跑。
#
# 构建（上下文仍然是 Runner 目录）：
#   docker build -f runners/aisbench-sla/tests/Dockerfile.stub runners/aisbench-sla -t <img>:stub
# 跑：
#   docker run --rm -v "$PWD/runners/aisbench-sla:/runner-src:ro" <img>:stub \
#     bash /runner/tests/smoke.sh
#   （也可以在构建后直接 `docker run --rm <img>:stub bash -lc 'cd /runner && bash tests/smoke.sh'`）
#
# 与真镜像的差别只有三处：没有 ais_bench 命令、没有真正依赖、体积小。
# run.sh / tool / fixtures 完全一致，所以 stub 冒烟验证的是**入口与结果映射**，不是模型能力。

FROM python:3.11-slim

# bash：run.sh 用 bash（数组 / PIPESTATUS）；ca-certificates：出站 HTTPS。
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 工具的运行时依赖（tool/requirements.txt）。
RUN pip install --no-cache-dir requests

# 非 root 运行（§12.2），uid/gid 与真镜像一致（10001）。
ARG RUNNER_UID=10001
ARG RUNNER_GID=10001
RUN groupadd -g ${RUNNER_GID} runner \
 && useradd -u ${RUNNER_UID} -g ${RUNNER_GID} -M -s /usr/sbin/nologin runner \
 && mkdir -p /workspace/output /runner /models \
 && chown -R ${RUNNER_UID}:${RUNNER_GID} /workspace /runner /models

# ---- 执行入口 + vendored 工具 + 测试（含 stub）--------------------------------
COPY run.sh /runner/run.sh
COPY tool /runner/tool
COPY tests /runner/tests
COPY tests/fixtures /runner/fixtures

# CRLF 归一：Windows 检出可能带 CRLF，会让 shebang 报 `python3\r`。
RUN sed -i 's/\r$//' /runner/run.sh \
 && find /runner/tool /runner/tests -name '*.py' -type f -exec sed -i 's/\r$//' {} + \
 && chmod 0755 /runner/run.sh /runner/tool/sla_search.py /runner/tool/tests/*.py \
 && chown -R ${RUNNER_UID}:${RUNNER_GID} /runner

USER ${RUNNER_UID}:${RUNNER_GID}

WORKDIR /workspace

ENTRYPOINT ["/runner/run.sh"]
